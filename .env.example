# Copie para .env.local e preencha. Nunca envie o .env.local para o git.

# 1 = dados de exemplo (não precisa de banco). Troque para 0 depois de preencher DATABASE_URL
HUB_MOCK=1

# Banco Postgres (Optimus Cloud), de onde o site lê os números. Peça a senha ao responsável pelo hub.
# Se a senha tiver caracteres especiais, deixe o valor entre aspas simples.
# DATABASE_URL='postgresql://USUARIO:SENHA@production-postgresql.cl25.absgroup.com.br:5490/marketing_hub?sslmode=verify-full'
DATABASE_URL=

# Texto aleatório e longo usado para assinar a sessão (gere um novo, ex.: openssl rand -hex 32)
AUTH_SECRET=

# Login com Google (Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web")
# Só entram contas do Google Workspace @absgroup.com.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Endereço público do site, sem barra no final (ex.: https://marketinghub.contadorceo.com.br). Vazio = usa o endereço acessado
APP_URL=

# API do hub no n8n (fluxo "[HUB] API do hub"). Hoje só serve para as miniaturas dos posts
HUB_API_URL=https://n8n.absgroup.com.br/webhook/hub-api
# Mesma senha da credencial "X-Hub-Key" no n8n. Se tiver aspas ou espaços, use aspas simples
HUB_API_KEY=

# Kastir (landing pages de lp.contadorceo.com.br), módulo Sites no ar: não precisa de variável.
# Quem lê o Kastir é o n8n (fluxo "[HUB] Kastir — páginas"), que grava no banco; o site lê de DATABASE_URL.

# Compactar vídeo: pasta onde ficam os vídeos enviados e compactados (apagados em 24 h).
# Vazio = pasta temporária do sistema. No servidor, use uma pasta própria com espaço livre.
COMPACTADOR_DIR=
